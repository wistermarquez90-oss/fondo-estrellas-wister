---
// src/pages/index.astro
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Feliz Cumpleaños Annarella</title>
  </head>
  <body>
    <!-- Capa 0: Nebulosa -->
    <div class="nebulosa"></div>
    
    <!-- Sistema Solar Realista -->
    <div class="sistema-solar">
      <div class="planeta-gigante"></div>
      <div class="orbita-luna">
        <div class="luna"></div>
      </div>
    </div>
    
    <!-- Capa 1: Lluvia de estrellas y meteoritos -->
    <div class="estrella-fugaz fugaz-1"></div>
    <div class="estrella-fugaz fugaz-2"></div>
    <div class="estrella-fugaz fugaz-3"></div>
    <div class="meteorito meteoro-1"></div>
    <div class="meteorito meteoro-2"></div>

    <!-- Capa 2: La foto de la cumpleañera -->
    <img src="foto-annarella.jpg" alt="Annarella" id="foto-annarella" />

    <!-- Capa 3: El lienzo de estrellas dinámicas -->
    <canvas id="universo"></canvas>

    <main class="contenedor-scroll">
      <div class="indicador">
        <h1>Baja para ver la sorpresa 👇</h1>
      </div>
    </main>

    <script>
      const canvas = document.getElementById('universo');
      const ctx = canvas.getContext('2d');
      const foto = document.getElementById('foto-annarella');
      
      let width, height;
      let estrellasFondo = []; 
      let estrellasDinamicas = []; 
      let puntosTexto = [];
      let progresoScroll = 0;

      const FRASE = "FELIZ CUMPLEAÑOS\nANNARELLA"; 

      function iniciar() {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
        obtenerCoordenadasTexto(FRASE);
        crearEstrellas();
      }

      function obtenerCoordenadasTexto(texto) {
        const canvasTemp = document.createElement('canvas');
        const ctxTemp = canvasTemp.getContext('2d');
        canvasTemp.width = width;
        canvasTemp.height = height;

        ctxTemp.fillStyle = 'white';
        let fontSize = width < 768 ? '10vw' : '7vw'; 
        ctxTemp.font = `900 ${fontSize} "Arial Black", sans-serif`; 
        ctxTemp.textAlign = 'center';
        ctxTemp.textBaseline = 'middle';
        
        const lineas = texto.split('\n');
        const startY = height * 0.75; 
        const lineHeight = width < 768 ? height * 0.08 : height * 0.12; 

        lineas.forEach((linea, index) => {
          ctxTemp.fillText(linea, width / 2, startY + (index * lineHeight));
        });

        const data = ctxTemp.getImageData(0, 0, width, height).data;
        puntosTexto = [];
        
        for (let y = 0; y < height; y += 6) {
          for (let x = 0; x < width; x += 6) {
            const alpha = data[(y * width + x) * 4 + 3];
            if (alpha > 128) {
              puntosTexto.push({ x, y });
            }
          }
        }
      }

      function crearEstrellas() {
        estrellasFondo = [];
        estrellasDinamicas = [];

        for (let i = 0; i < 300; i++) {
          estrellasFondo.push({
            x: Math.random() * width,
            y: Math.random() * height,
            tamano: Math.random() * 1.5, 
            faseBrillo: Math.random() * Math.PI * 2,
            velocidadBrillo: Math.random() * 0.5 + 0.2 
          });
        }

        const numDinamicas = Math.max(puntosTexto.length, 500); 
        for (let i = 0; i < numDinamicas; i++) {
          const destino = puntosTexto[i] || {
            x: Math.random() * width,
            y: Math.random() * height
          };

          estrellasDinamicas.push({
            xInicial: Math.random() * width,
            yInicial: Math.random() * height,
            xDestino: destino.x,
            yDestino: destino.y,
            tamanoBase: Math.random() * 1.2 + 0.6, 
            formaTexto: i < puntosTexto.length,
            faseBrillo: Math.random() * Math.PI * 2, 
            velocidadBrillo: Math.random() * 2 + 1 
          });
        }
      }

      window.addEventListener('scroll', () => {
        const scrollMaximo = document.body.scrollHeight - window.innerHeight;
        progresoScroll = Math.min(Math.max(window.scrollY / scrollMaximo, 0), 1);
      });

      function animar() {
        ctx.clearRect(0, 0, width, height);
        const tiempo = Date.now() * 0.001; 
        let progresoAcelerado = Math.min(progresoScroll * 2, 1);
        let interpolacion = 1 - Math.pow(1 - progresoAcelerado, 3);

        if (progresoAcelerado > 0.4) {
           let progresoFoto = Math.min((progresoAcelerado - 0.4) * 1.66, 1);
           foto.style.opacity = progresoFoto;
           foto.style.transform = `translate(-50%, -60%) scale(${0.7 + (progresoFoto * 0.3)})`;
        } else {
           foto.style.opacity = 0;
           foto.style.transform = `translate(-50%, -50%) scale(0.7)`;
        }

        estrellasFondo.forEach(estrella => {
          let oscilacion = Math.sin(tiempo * estrella.velocidadBrillo + estrella.faseBrillo);
          ctx.fillStyle = `rgba(255, 255, 255, ${0.3 + (oscilacion * 0.4)})`;
          ctx.beginPath();
          ctx.arc(estrella.x, estrella.y, estrella.tamano, 0, Math.PI * 2);
          ctx.fill();
        });

        estrellasDinamicas.forEach(estrella => {
          let xActual = estrella.xInicial + (estrella.xDestino - estrella.xInicial) * interpolacion;
          let yActual = estrella.yInicial + (estrella.yDestino - estrella.yInicial) * interpolacion;
          
          let oscilacion = Math.sin(tiempo * estrella.velocidadBrillo + estrella.faseBrillo);
          let tamanoActual = estrella.tamanoBase + (oscilacion * 0.3);

          if (estrella.formaTexto && progresoAcelerado > 0.6) {
            ctx.fillStyle = `rgba(255, 105, 180, ${progresoAcelerado * 0.5})`; 
            ctx.beginPath();
            ctx.arc(xActual, yActual, tamanoActual * 3, 0, Math.PI * 2);
            ctx.fill();
            
            ctx.fillStyle = 'rgba(255, 255, 255, 1)'; 
          } else {
            ctx.fillStyle = `rgba(255, 255, 255, ${0.5 + (oscilacion * 0.4)})`;
          }

          ctx.beginPath();
          ctx.arc(xActual, yActual, tamanoActual, 0, Math.PI * 2);
          ctx.fill();
        });

        requestAnimationFrame(animar);
      }

      window.addEventListener('resize', iniciar);
      iniciar();
      animar();
    </script>
  </body>
</html>

<style>
  body, html {
    margin: 0;
    padding: 0;
    background-color: #020306; 
    color: white;
    font-family: sans-serif;
    overflow-x: hidden;
  }
  
  .nebulosa {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: 
      radial-gradient(circle at 20% 30%, rgba(55, 20, 80, 0.4) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(20, 60, 100, 0.3) 0%, transparent 50%),
      radial-gradient(circle at 50% 100%, rgba(100, 20, 60, 0.25) 0%, transparent 60%);
    z-index: 0;
  }

  /* --- SISTEMA SOLAR REALISTA --- */
  .sistema-solar {
    position: fixed;
    top: 5%;
    right: 5%;
    width: clamp(150px, 25vw, 350px);
    height: clamp(150px, 25vw, 350px);
    z-index: 1;
  }

  /* La Tierra */
  .planeta-gigante {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    /* Textura fotográfica real de la Tierra */
    background-image: url('https://upload.wikimedia.org/wikipedia/commons/thumb/0/04/Solarsystemscope_texture_8k_earth_daymap.jpg/1024px-Solarsystemscope_texture_8k_earth_daymap.jpg');
    background-size: 200% 100%;
    /* Sombra interna brutal para hacerla 3D (iluminada a la derecha, oscura a la izquierda) */
    box-shadow: inset -50px -50px 80px rgba(0,0,0,0.95), inset 10px 10px 30px rgba(255,255,255,0.2), 0 0 50px rgba(100, 150, 255, 0.3);
    animation: rotarTextura 40s linear infinite;
  }

  .orbita-luna {
    position: absolute;
    top: -15%;
    left: -15%;
    width: 130%;
    height: 130%;
    border-radius: 50%;
    /* Hace que la luna dé vueltas alrededor de la Tierra */
    animation: rotarOrbita 25s linear infinite;
  }

  /* La Luna */
  .luna {
    position: absolute;
    top: 0;
    left: 50%;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    /* Textura fotográfica real de la Luna */
    background-image: url('https://upload.wikimedia.org/wikipedia/commons/thumb/d/d4/Solarsystemscope_texture_8k_moon.jpg/512px-Solarsystemscope_texture_8k_moon.jpg');
    background-size: 200% 100%;
    /* Sombra interna para el efecto esférico */
    box-shadow: inset -15px -15px 20px rgba(0,0,0,0.95);
    transform: translateX(-50%);
    animation: rotarTextura 25s linear infinite;
  }

  /* Animación que desliza el mapa para simular rotación esférica */
  @keyframes rotarTextura {
    from { background-position: 0% 0%; }
    to { background-position: 200% 0%; }
  }

  @keyframes rotarOrbita {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* --- LA FOTO DE ANNARELLA --- */
  #foto-annarella {
    position: fixed;
    top: 40%; 
    left: 50%;
    width: clamp(200px, 40vw, 350px);
    height: clamp(200px, 40vw, 350px);
    object-fit: cover;
    border-radius: 50%;
    z-index: 2; 
    box-shadow: 0 0 40px rgba(255, 105, 180, 0.5), 0 0 100px rgba(0, 242, 254, 0.3);
    border: 3px solid rgba(255, 255, 255, 0.8);
    pointer-events: none;
    opacity: 0; 
  }

  #universo {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 3;
    pointer-events: none;
  }
  
  /* --- ESTRELLAS FUGACES Y METEORITOS --- */
  .estrella-fugaz, .meteorito {
    position: fixed;
    border-radius: 50%;
    z-index: 4; 
    opacity: 0;
  }
  
  .estrella-fugaz {
    width: 3px;
    height: 3px;
    background: white;
    box-shadow: 0 0 10px white;
  }
  .estrella-fugaz::after {
    content: '';
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 150px; 
    height: 1px;
    background: linear-gradient(90deg, rgba(255,255,255,0.8), transparent);
  }

  .meteorito {
    width: 8px;
    height: 8px;
    background: #ffdb58;
    box-shadow: 0 0 20px #ffdb58, 0 0 40px #ff8c00;
  }
  .meteorito::after {
    content: '';
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 300px; 
    height: 4px;
    background: linear-gradient(90deg, #ff8c00, #ff0000, transparent);
  }

  .fugaz-1 { top: 20%; left: 100%; animation: animarFugaz 7s linear infinite; animation-delay: 1s; }
  .fugaz-2 { top: 60%; left: 110%; animation: animarFugaz 11s linear infinite; animation-delay: 4s; }
  .fugaz-3 { top: 85%; left: 120%; animation: animarFugaz 14s linear infinite; animation-delay: 8s; }
  
  .meteoro-1 { top: 15%; left: 130%; animation: animarFugaz 15s linear infinite; animation-delay: 5s; }
  .meteoro-2 { top: 70%; left: 150%; animation: animarFugaz 22s linear infinite; animation-delay: 12s; }

  @keyframes animarFugaz {
    0% { transform: translateX(0) translateY(0) rotate(-35deg); opacity: 1; }
    3% { opacity: 1; }
    10% { opacity: 0; }
    100% { transform: translateX(-2500px) translateY(1750px) rotate(-35deg); opacity: 0; }
  }

  .contenedor-scroll {
    position: relative;
    height: 300vh;
    z-index: 10;
  }
  
  .indicador {
    position: fixed;
    top: 5%;
    width: 100%;
    text-align: center;
    pointer-events: none;
    opacity: 0.7;
    text-shadow: 0px 0px 10px rgba(255,255,255,0.5);
  }
</style>