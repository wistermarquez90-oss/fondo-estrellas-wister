---
// src/pages/index.astro
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Feliz Cumpleaños Annarella</title>
  </head>
  <body>
    <div class="nebulosa" id="nebulosa"></div>
    <canvas id="universo-fondo"></canvas>
    <div id="contenedor-3d"></div>
    
    <div id="lluvia-meteoritos">
      <div class="estrella-fugaz fugaz-1"></div>
      <div class="estrella-fugaz fugaz-2"></div>
      <div class="estrella-fugaz fugaz-3"></div>
      <div class="meteorito meteoro-1"></div>
    </div>

    <div class="ui-contenedor" id="ui-textos">
      <img src="/fondo-estrellas-wister/foto-annarella.jpg" alt="Annarella" id="foto-annarella" />
      
      <div class="mensaje-elegante" id="texto-cumple">
        <span class="feliz">FELIZ</span>
        <span class="cumple">CUMPLEAÑOS</span>
        <span class="nombre">ANNARELLA</span>
      </div>
    </div>

    <button id="btn-galaxia" class="oculto">PRESIONA AQUÍ</button>

    <main class="contenedor-scroll" id="zona-scroll">
      <div class="indicador" id="indicador-scroll">
        <h1>Baja para ver la sorpresa 👇</h1>
      </div>
    </main>

    <script>
      // ==========================================
      // MOTOR 3D Y SHADERS: GALAXIA HIPERREALISTA
      // ==========================================
      
      // @ts-ignore
      import('https://cdn.jsdelivr.net/npm/three@0.158.0/build/three.module.js').then((THREE) => {
        const contenedor3D = document.getElementById('contenedor-3d') as HTMLDivElement;
        const btnGalaxia = document.getElementById('btn-galaxia') as HTMLButtonElement;
        
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.z = 12; 
        
        const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight); 
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2)); 
        renderer.domElement.style.width = '100%';
        renderer.domElement.style.height = '100%';
        contenedor3D.appendChild(renderer.domElement);

        const textureLoader = new THREE.TextureLoader();
        const urlEarth = 'https://raw.githubusercontent.com/mrdoob/three.js/master/examples/textures/planets/earth_atmos_2048.jpg';
        const urlSpecular = 'https://raw.githubusercontent.com/mrdoob/three.js/master/examples/textures/planets/earth_specular_2048.jpg';
        const urlClouds = 'https://raw.githubusercontent.com/mrdoob/three.js/master/examples/textures/planets/earth_clouds_1024.png';
        const urlMoon = 'https://raw.githubusercontent.com/mrdoob/three.js/master/examples/textures/planets/moon_1024.jpg';

        const ambientLight = new THREE.AmbientLight(0xffffff, 0.3); 
        scene.add(ambientLight);
        const sunLight = new THREE.DirectionalLight(0xffffff, 2.5); 
        sunLight.position.set(-10, 5, 5); 
        scene.add(sunLight);

        // --- SISTEMA TIERRA-LUNA ---
        const sistemaPlanetario = new THREE.Group();
        scene.add(sistemaPlanetario);

        const earthGeo = new THREE.SphereGeometry(2.5, 64, 64); 
        const earthMat = new THREE.MeshPhongMaterial({ 
            map: textureLoader.load(urlEarth),
            specularMap: textureLoader.load(urlSpecular), 
            specular: new THREE.Color('grey'),
            shininess: 30
        });
        const earth = new THREE.Mesh(earthGeo, earthMat);
        sistemaPlanetario.add(earth);

        const cloudGeo = new THREE.SphereGeometry(2.55, 64, 64);
        const cloudMat = new THREE.MeshLambertMaterial({
            map: textureLoader.load(urlClouds),
            transparent: true, opacity: 0.8,
            blending: THREE.AdditiveBlending 
        });
        const clouds = new THREE.Mesh(cloudGeo, cloudMat);
        sistemaPlanetario.add(clouds);

        const moonPivot = new THREE.Group();
        sistemaPlanetario.add(moonPivot);
        const moonGeo = new THREE.SphereGeometry(0.6, 64, 64);
        const moonMat = new THREE.MeshStandardMaterial({ map: textureLoader.load(urlMoon), roughness: 0.9 });
        const moon = new THREE.Mesh(moonGeo, moonMat);
        moon.position.set(4.8, 0, 0); 
        moonPivot.add(moon);

        const asteroidGeo = new THREE.DodecahedronGeometry(0.8, 3); 
        const posiciones = asteroidGeo.attributes.position;
        for(let i = 0; i < posiciones.count; i++) {
            const def = 1 + (Math.random() * 0.4 - 0.2); 
            posiciones.setXYZ(i, posiciones.getX(i)*def, posiciones.getY(i)*def, posiciones.getZ(i)*def);
        }
        asteroidGeo.computeVertexNormals(); 
        const asteroidMat = new THREE.MeshStandardMaterial({ map: textureLoader.load(urlMoon), roughness: 0.8, color: 0xaaaaaa });
        const asteroid = new THREE.Mesh(asteroidGeo, asteroidMat);
        scene.add(asteroid); 

        // ==========================================
        // GALAXIA REALISTA CON POLVO Y LATIDO DE LUZ
        // ==========================================
        
        // 1. GENERADOR DE TEXTURAS (Para evitar imágenes cuadradas)
        function crearTextura(tipo: string) {
            const canvas = document.createElement('canvas');
            canvas.width = 64; canvas.height = 64;
            const ctx = canvas.getContext('2d') as CanvasRenderingContext2D;
            const gradiente = ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
            
            if (tipo === 'estrella') {
                gradiente.addColorStop(0, 'rgba(255, 255, 255, 1)');
                gradiente.addColorStop(0.2, 'rgba(255, 255, 255, 0.8)');
                gradiente.addColorStop(0.4, 'rgba(255, 255, 255, 0.2)');
                gradiente.addColorStop(1, 'rgba(0, 0, 0, 0)');
            } else { // Polvo
                gradiente.addColorStop(0, 'rgba(255, 255, 255, 0.3)');
                gradiente.addColorStop(0.5, 'rgba(255, 255, 255, 0.05)');
                gradiente.addColorStop(1, 'rgba(0, 0, 0, 0)');
            }
            ctx.fillStyle = gradiente;
            ctx.fillRect(0, 0, 64, 64);
            return new THREE.CanvasTexture(canvas);
        }
        
        const texEstrella = crearTextura('estrella');
        const texPolvo = crearTextura('polvo');

        const galaxiaGroup = new THREE.Group();
        scene.add(galaxiaGroup);
        galaxiaGroup.visible = false; 
        galaxiaGroup.position.z = -20; 
        galaxiaGroup.rotation.x = 0.5; // Inclinación épica
        
        // 2. SHADER MATERIAL (Para que las estrellas parpadeen vivas)
        const starUniforms = {
            uTime: { value: 0 },
            uTexture: { value: texEstrella }
        };

        const materialEstrellas = new THREE.ShaderMaterial({
            uniforms: starUniforms,
            vertexShader: `
                attribute float size;
                attribute float phase;
                varying vec3 vColor;
                uniform float uTime;
                void main() {
                    vColor = color;
                    // Latido matemático (Oscila entre 0 y 1)
                    float twinkle = (sin(uTime * 1.5 + phase) + 1.0) * 0.5;
                    float currentSize = size * (0.3 + twinkle * 1.5); 
                    
                    vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);
                    gl_PointSize = currentSize * (30.0 / -mvPosition.z);
                    gl_Position = projectionMatrix * mvPosition;
                }
            `,
            fragmentShader: `
                uniform sampler2D uTexture;
                varying vec3 vColor;
                void main() {
                    vec4 texColor = texture2D(uTexture, gl_PointCoord);
                    gl_FragColor = vec4(vColor, 1.0) * texColor;
                }
            `,
            transparent: true,
            blending: THREE.AdditiveBlending,
            depthWrite: false,
            vertexColors: true
        });

        const materialPolvo = new THREE.PointsMaterial({
            size: 4.0,
            map: texPolvo,
            transparent: true,
            opacity: 0.6,
            blending: THREE.AdditiveBlending,
            depthWrite: false,
            vertexColors: true
        });

        // 3. MATEMÁTICA DE LA ESPIRAL
        const countEstrellas = 15000;
        const countPolvo = 4000;
        const radioGalaxia = 30;
        const brazos = 4;

        function crearGeometria(cantidad: number, isDust: boolean) {
            const geo = new THREE.BufferGeometry();
            const positions = new Float32Array(cantidad * 3);
            const colors = new Float32Array(cantidad * 3);
            const sizes = new Float32Array(cantidad);
            const phases = new Float32Array(cantidad);

            const colorCentro = new THREE.Color(0xfff4e0); // Blanco cálido brillante
            const colorRosa = new THREE.Color(0xff1493);
            const colorAzul = new THREE.Color(0x00f2fe);
            const colorBorde = new THREE.Color(0x111133); // Oscuro

            for(let i = 0; i < cantidad; i++) {
                // Concentrar muchísimo más en el núcleo
                const radio = Math.pow(Math.random(), 2.5) * radioGalaxia; 
                const angulo = (i % brazos) * ((Math.PI * 2) / brazos);
                const giro = radio * 0.35; 
                
                // Dispersión (menos disperso en el centro, más en los bordes)
                const dispersion = (Math.random() - 0.5) * (radio / radioGalaxia) * 3;
                
                // Abultamiento central (Bulge galáctico)
                const alturaBulge = (Math.random() - 0.5) * (4 * Math.exp(-radio/4));

                positions[i*3] = Math.cos(angulo + giro) * radio + (Math.random() - 0.5) * dispersion;
                positions[i*3+1] = alturaBulge + (isDust ? (Math.random()-0.5)*1.5 : 0);
                positions[i*3+2] = Math.sin(angulo + giro) * radio + (Math.random() - 0.5) * dispersion;

                // Color según la distancia al núcleo
                let mixedColor = colorCentro.clone();
                if(radio > 2) mixedColor.lerp(i%2==0 ? colorRosa : colorAzul, radio / (radioGalaxia * 0.5));
                if(radio > radioGalaxia * 0.7) mixedColor.lerp(colorBorde, (radio - radioGalaxia*0.7) / (radioGalaxia*0.3));

                colors[i*3] = mixedColor.r;
                colors[i*3+1] = mixedColor.g;
                colors[i*3+2] = mixedColor.b;

                // Tamaño y fase individual para el latido
                sizes[i] = (Math.random() * 2) + 0.5;
                phases[i] = Math.random() * Math.PI * 2;
            }

            geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
            geo.setAttribute('color', new THREE.BufferAttribute(colors, 3));
            if(!isDust) {
                geo.setAttribute('size', new THREE.BufferAttribute(sizes, 1));
                geo.setAttribute('phase', new THREE.BufferAttribute(phases, 1));
            }
            return geo;
        }

        const estrellas = new THREE.Points(crearGeometria(countEstrellas, false), materialEstrellas);
        const polvo = new THREE.Points(crearGeometria(countPolvo, true), materialPolvo);
        
        galaxiaGroup.add(estrellas);
        galaxiaGroup.add(polvo);

        // --- RESPONSIVE 3D ---
        function actualizarLayout3D() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
            
            if (window.innerWidth < 768) {
                sistemaPlanetario.position.set(1.2, 4.5, -4);
                sistemaPlanetario.scale.set(0.5, 0.5, 0.5);
            } else {
                sistemaPlanetario.position.set(4, 3, -2);
                sistemaPlanetario.scale.set(1, 1, 1);
            }
        }
        window.addEventListener('resize', actualizarLayout3D);
        actualizarLayout3D(); 

        let tiempoAsteroide = 0;
        let modoGalaxia = false;
        
        // Físicas de la Galaxia
        let tiempoShader = 0;
        let velocidadGalaxia = 0.015; // Velocidad de giro inicial muy rápida (por el impulso)

        // --- EVENTO CLIC ---
        btnGalaxia.addEventListener('click', () => {
            modoGalaxia = true;
            document.getElementById('zona-scroll')!.style.display = 'none';
            document.getElementById('ui-textos')!.style.opacity = '0';
            btnGalaxia.style.opacity = '0';
            btnGalaxia.style.pointerEvents = 'none';
            
            document.getElementById('lluvia-meteoritos')!.style.opacity = '0';
            document.getElementById('universo-fondo')!.style.opacity = '0';
            document.getElementById('nebulosa')!.style.opacity = '0'; 
            
            galaxiaGroup.visible = true;
        });

        function animate3D() {
          requestAnimationFrame(animate3D);
          
          if(!modoGalaxia) {
              earth.rotation.y += 0.001;       
              clouds.rotation.y += 0.0015; 
              moonPivot.rotation.y += 0.003;   
              moon.rotation.y += 0.002;        
              
              tiempoAsteroide += 0.005;
              asteroid.position.x = Math.cos(tiempoAsteroide * 0.8) * 8;
              asteroid.position.y = Math.sin(tiempoAsteroide * 1.5) * 6;
              asteroid.position.z = Math.sin(tiempoAsteroide * 1.2) * 5; 
              asteroid.rotation.x += 0.02;
              asteroid.rotation.y += 0.01;
          } else {
              // Hunden los planetas
              sistemaPlanetario.position.y -= 0.15;
              asteroid.position.y -= 0.15;
              
              // Viaje de cámara hacia la galaxia
              if(camera.position.z > 3) camera.position.z -= 0.1;
              
              // --- EL LATIDO DE LAS ESTRELLAS (Siempre activo) ---
              tiempoShader += 0.01;
              starUniforms.uTime.value = tiempoShader;
              
              // --- FRENADO CINÉTICO DE LA GALAXIA ---
              if (velocidadGalaxia > 0.0002) { // 0.0002 es una flotación residual casi imperceptible
                  velocidadGalaxia -= 0.00003; // Fricción suave
              } else {
                  velocidadGalaxia = 0.0002; // Se detiene y solo "flota"
              }
              
              galaxiaGroup.rotation.y += velocidadGalaxia;
          }

          renderer.render(scene, camera);
        }
        animate3D();
      });

      // ==========================================
      // CONTROLADOR DE SCROLL 
      // ==========================================
      const canvasFondo = document.getElementById('universo-fondo') as HTMLCanvasElement;
      const ctxFondo = canvasFondo.getContext('2d') as CanvasRenderingContext2D;
      
      const foto = document.getElementById('foto-annarella') as HTMLImageElement;
      const textoCumple = document.getElementById('texto-cumple') as HTMLDivElement;
      const btnGalaxia2 = document.getElementById('btn-galaxia') as HTMLButtonElement;
      const indicadorScroll = document.getElementById('indicador-scroll') as HTMLDivElement;
      
      let width: number, height: number;
      let estrellasFondo: any[] = []; 
      let progresoScroll: number = 0;

      function iniciarFondo() {
        width = canvasFondo.width = window.innerWidth;
        height = canvasFondo.height = window.innerHeight;
        
        estrellasFondo = [];
        const cantidadFondo = width < 768 ? 200 : 400;
        for (let i = 0; i < cantidadFondo; i++) {
          estrellasFondo.push({
            x: Math.random() * width,
            y: Math.random() * height,
            tamano: Math.random() * 1.5, 
            faseBrillo: Math.random() * Math.PI * 2,
            velocidadBrillo: Math.random() * 0.5 + 0.2 
          });
        }
      }

      window.addEventListener('scroll', () => {
        const scrollMaximo = document.body.scrollHeight - window.innerHeight;
        progresoScroll = Math.min(Math.max(window.scrollY / scrollMaximo, 0), 1);
        
        if(progresoScroll > 0.05) indicadorScroll.style.opacity = '0';
        else indicadorScroll.style.opacity = '0.7';

        if (progresoScroll > 0.2) {
           let progresoFoto = Math.min((progresoScroll - 0.2) * 2, 1);
           foto.style.opacity = progresoFoto.toString();
           foto.style.transform = `translate(-50%, 0) scale(${0.8 + (progresoFoto * 0.2)})`;
        } else {
           foto.style.opacity = "0";
           foto.style.transform = `translate(-50%, 50px) scale(0.8)`;
        }

        if (progresoScroll > 0.5) {
           let progresoTexto = Math.min((progresoScroll - 0.5) * 2.5, 1);
           textoCumple.style.opacity = progresoTexto.toString();
           textoCumple.style.transform = `translate(-50%, 0) scale(${0.9 + (progresoTexto * 0.1)})`;
        } else {
           textoCumple.style.opacity = "0";
           textoCumple.style.transform = `translate(-50%, 30px) scale(0.9)`;
        }

        if (progresoScroll > 0.95) {
            btnGalaxia2.classList.remove('oculto');
        } else {
            btnGalaxia2.classList.add('oculto');
        }
      });

      function animarFondo() {
        ctxFondo.clearRect(0, 0, width, height);
        const tiempo = Date.now() * 0.001; 

        estrellasFondo.forEach(estrella => {
          let oscilacion = Math.sin(tiempo * estrella.velocidadBrillo + estrella.faseBrillo);
          ctxFondo.fillStyle = `rgba(255, 255, 255, ${0.3 + (oscilacion * 0.4)})`;
          ctxFondo.beginPath();
          ctxFondo.arc(estrella.x, estrella.y, estrella.tamano, 0, Math.PI * 2);
          ctxFondo.fill();
        });
        requestAnimationFrame(animarFondo);
      }

      window.addEventListener('resize', iniciarFondo);
      iniciarFondo();
      animarFondo();
    </script>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@800;900&display=swap');

  body, html {
    margin: 0; padding: 0;
    background-color: #000000; /* Negro absoluto para contrastar la galaxia */
    color: white;
    font-family: 'Montserrat', sans-serif;
    overflow-x: hidden;
  }
  
  .nebulosa { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: radial-gradient(circle at 20% 30%, rgba(55, 20, 80, 0.4) 0%, transparent 50%), radial-gradient(circle at 80% 70%, rgba(20, 60, 100, 0.3) 0%, transparent 50%), radial-gradient(circle at 50% 100%, rgba(100, 20, 60, 0.25) 0%, transparent 60%); z-index: 0; transition: opacity 2s ease; }
  
  #universo-fondo { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 1; pointer-events: none; transition: opacity 2s ease; }
  #contenedor-3d { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 2; pointer-events: none; }
  #lluvia-meteoritos { z-index: 3; pointer-events: none; transition: opacity 2s ease; }
  
  /* --- INTERFAZ UI --- */
  .ui-contenedor { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 10; pointer-events: none; transition: opacity 1.5s ease; }

  #foto-annarella {
    position: absolute; top: 15vh; left: 50%;
    transform: translate(-50%, 50px);
    width: clamp(160px, 40vw, 300px); height: clamp(160px, 40vw, 300px);
    object-fit: cover; border-radius: 50%;
    box-shadow: 0 0 40px rgba(255, 105, 180, 0.6), 0 0 80px rgba(0, 242, 254, 0.4);
    border: 4px solid rgba(255, 255, 255, 0.9);
    opacity: 0; transition: transform 0.1s linear, opacity 0.1s linear;
  }

  .mensaje-elegante {
    position: absolute; top: calc(15vh + clamp(160px, 40vw, 300px) + 30px); left: 50%;
    transform: translate(-50%, 30px); text-align: center; display: flex; flex-direction: column; gap: 10px;
    opacity: 0; transition: transform 0.1s linear, opacity 0.1s linear;
  }

  .mensaje-elegante span { line-height: 1; letter-spacing: 4px; text-shadow: 0 0 20px rgba(255, 105, 180, 0.8), 0 0 40px rgba(0, 242, 254, 0.6); }

  .feliz { font-size: clamp(2rem, 8vw, 4rem); font-weight: 800; color: #fff; }
  .cumple { font-size: clamp(2.5rem, 10vw, 5rem); font-weight: 900; color: #fff; background: -webkit-linear-gradient(45deg, #ff69b4, #00f2fe); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .nombre { font-size: clamp(2rem, 8vw, 4rem); font-weight: 800; color: #fff; }

  /* --- BOTÓN ABSOLUTAMENTE CLICABLE --- */
  #btn-galaxia {
    position: fixed; bottom: 10vh; left: 50%; transform: translateX(-50%);
    padding: 15px 40px; font-size: 1.2rem; font-weight: 800; font-family: 'Montserrat', sans-serif;
    color: white; background: linear-gradient(45deg, #ff1493, #00f2fe);
    border: none; border-radius: 30px; cursor: pointer; z-index: 50; pointer-events: auto; 
    box-shadow: 0 0 20px rgba(255, 20, 147, 0.5), 0 0 40px rgba(0, 242, 254, 0.5);
    transition: all 0.5s ease; animation: palpitar 2s infinite;
  }

  #btn-galaxia:hover, #btn-galaxia:active { transform: translateX(-50%) scale(1.1); box-shadow: 0 0 30px rgba(255, 20, 147, 0.8), 0 0 60px rgba(0, 242, 254, 0.8); }
  #btn-galaxia.oculto { opacity: 0; pointer-events: none; transform: translateX(-50%) translateY(20px); }

  @keyframes palpitar {
    0% { box-shadow: 0 0 20px rgba(255, 20, 147, 0.5), 0 0 40px rgba(0, 242, 254, 0.5); }
    50% { box-shadow: 0 0 40px rgba(255, 20, 147, 0.8), 0 0 80px rgba(0, 242, 254, 0.8); }
    100% { box-shadow: 0 0 20px rgba(255, 20, 147, 0.5), 0 0 40px rgba(0, 242, 254, 0.5); }
  }

  .contenedor-scroll { position: relative; height: 350vh; z-index: 20; }
  .indicador { position: fixed; top: 5%; width: 100%; text-align: center; pointer-events: none; transition: opacity 0.5s; text-shadow: 0px 0px 10px rgba(255,255,255,0.5); }

  .estrella-fugaz, .meteorito { position: fixed; border-radius: 50%; opacity: 0; }
  .estrella-fugaz { width: 3px; height: 3px; background: white; box-shadow: 0 0 10px white; }
  .estrella-fugaz::after { content: ''; position: absolute; top: 50%; transform: translateY(-50%); width: 150px; height: 1px; background: linear-gradient(90deg, rgba(255,255,255,0.8), transparent); }
  .meteorito { width: 8px; height: 8px; background: #ffdb58; box-shadow: 0 0 20px #ffdb58, 0 0 40px #ff8c00; }
  .meteorito::after { content: ''; position: absolute; top: 50%; transform: translateY(-50%); width: 300px; height: 4px; background: linear-gradient(90deg, #ff8c00, #ff0000, transparent); }

  .fugaz-1 { top: 20%; left: 100%; animation: animarFugaz 7s linear infinite; animation-delay: 1s; }
  .fugaz-2 { top: 60%; left: 110%; animation: animarFugaz 11s linear infinite; animation-delay: 4s; }
  .fugaz-3 { top: 85%; left: 120%; animation: animarFugaz 14s linear infinite; animation-delay: 8s; }
  .meteoro-1 { top: 15%; left: 130%; animation: animarFugaz 15s linear infinite; animation-delay: 5s; }

  @keyframes animarFugaz {
    0% { transform: translateX(0) translateY(0) rotate(-35deg); opacity: 1; }
    3% { opacity: 1; }
    10% { opacity: 0; }
    100% { transform: translateX(-2500px) translateY(1750px) rotate(-35deg); opacity: 0; }
  }

  @media (max-width: 768px) { .indicador h1 { font-size: 5vw; } }
</style>