---
// src/pages/index.astro
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Feliz Cumpleaños Annarella</title>
  </head>
  <body>
    <!-- Capa 0: Nebulosa oscura -->
    <div class="nebulosa"></div>
    
    <!-- Capa 1: Estrellas estáticas del fondo (Siempre detrás de los planetas) -->
    <canvas id="universo-fondo"></canvas>

    <!-- Capa 2: Motor 3D a pantalla completa (Planetas y Asteroide) -->
    <div id="contenedor-3d"></div>
    
    <!-- Capa 3: Meteoritos CSS -->
    <div class="estrella-fugaz fugaz-1"></div>
    <div class="estrella-fugaz fugaz-2"></div>
    <div class="estrella-fugaz fugaz-3"></div>
    <div class="meteorito meteoro-1"></div>
    <div class="meteorito meteoro-2"></div>

    <!-- Capa 4: Foto de Annarella -->
    <img src="/fondo-estrellas-wister/foto-annarella.jpg" alt="Annarella" id="foto-annarella" />
    
    <!-- Capa 5: Estrellas dinámicas que forman la palabra (Siempre al frente) -->
    <canvas id="universo-frente"></canvas>

    <main class="contenedor-scroll">
      <div class="indicador">
        <h1>Baja para ver la sorpresa 👇</h1>
      </div>
    </main>

    <script>
      // ==========================================
      // MOTOR 3D: TIERRA HIPERREALISTA A PANTALLA COMPLETA
      // ==========================================
      import('https://cdn.jsdelivr.net/npm/three@0.158.0/build/three.module.js').then((THREE) => {
        const contenedor3D = document.getElementById('contenedor-3d');
        
        const scene = new THREE.Scene();
        // Cámara ajustada a la pantalla completa
        const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 100);
        camera.position.z = 12; // Cámara más alejada para ver todo el entorno
        
        const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight); 
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2)); 
        renderer.domElement.style.width = '100%';
        renderer.domElement.style.height = '100%';
        contenedor3D.appendChild(renderer.domElement);

        // Cargador de texturas (Usando repositorios oficiales sin bloqueo CORS)
        const textureLoader = new THREE.TextureLoader();
        const urlEarth = 'https://raw.githubusercontent.com/mrdoob/three.js/master/examples/textures/planets/earth_atmos_2048.jpg';
        const urlSpecular = 'https://raw.githubusercontent.com/mrdoob/three.js/master/examples/textures/planets/earth_specular_2048.jpg';
        const urlClouds = 'https://raw.githubusercontent.com/mrdoob/three.js/master/examples/textures/planets/earth_clouds_1024.png';
        const urlMoon = 'https://raw.githubusercontent.com/mrdoob/three.js/master/examples/textures/planets/moon_1024.jpg';

        // --- ILUMINACIÓN REALISTA ---
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.3); // Luz de fondo tenue
        scene.add(ambientLight);
        
        const sunLight = new THREE.DirectionalLight(0xffffff, 2.5); // El Sol pegando desde la izquierda
        sunLight.position.set(-10, 5, 5); 
        scene.add(sunLight);
        
        const atmLight = new THREE.PointLight(0x4488ff, 1.5, 20); // Resplandor azulado atmosférico
        atmLight.position.set(2, 0, 3);
        scene.add(atmLight);

        // --- SISTEMA TIERRA-LUNA (Grupo para moverlos juntos) ---
        const sistemaPlanetario = new THREE.Group();
        scene.add(sistemaPlanetario);

        // 1. La Tierra con reflejos oceánicos
        const earthGeo = new THREE.SphereGeometry(2.5, 64, 64); 
        const earthMat = new THREE.MeshPhongMaterial({ 
            map: textureLoader.load(urlEarth),
            specularMap: textureLoader.load(urlSpecular), // Solo brilla el agua
            specular: new THREE.Color('grey'),
            shininess: 30
        });
        const earth = new THREE.Mesh(earthGeo, earthMat);
        sistemaPlanetario.add(earth);

        // 2. Capa de nubes independiente que gira a otra velocidad
        const cloudGeo = new THREE.SphereGeometry(2.55, 64, 64);
        const cloudMat = new THREE.MeshLambertMaterial({
            map: textureLoader.load(urlClouds),
            transparent: true,
            opacity: 0.8,
            blending: THREE.AdditiveBlending // Hace que las nubes se iluminen realísticamente
        });
        const clouds = new THREE.Mesh(cloudGeo, cloudMat);
        sistemaPlanetario.add(clouds);

        // 3. La Luna
        const moonPivot = new THREE.Group();
        sistemaPlanetario.add(moonPivot);

        const moonGeo = new THREE.SphereGeometry(0.6, 64, 64);
        const moonMat = new THREE.MeshStandardMaterial({ 
            map: textureLoader.load(urlMoon), 
            roughness: 0.9 
        });
        const moon = new THREE.Mesh(moonGeo, moonMat);
        moon.position.set(4.8, 0, 0); 
        moonPivot.add(moon);

        // --- ASTEROIDE DEFORMADO HIPERREALISTA ---
        const asteroidGeo = new THREE.DodecahedronGeometry(0.8, 3); // Nivel 3 de detalle = más polígonos
        const posiciones = asteroidGeo.attributes.position;
        for(let i = 0; i < posiciones.count; i++) {
            const deformacion = 1 + (Math.random() * 0.4 - 0.2); // Rompe la esfera para hacerla una roca
            posiciones.setXYZ(i, posiciones.getX(i)*deformacion, posiciones.getY(i)*deformacion, posiciones.getZ(i)*deformacion);
        }
        asteroidGeo.computeVertexNormals(); 

        const asteroidMat = new THREE.MeshStandardMaterial({ 
            map: textureLoader.load(urlMoon), // Usamos roca lunar
            roughness: 0.8,
            color: 0xaaaaaa 
        });
        const asteroid = new THREE.Mesh(asteroidGeo, asteroidMat);
        scene.add(asteroid); // El asteroide no pertenece al grupo del planeta, va libre

        // --- ADAPTACIÓN RESPONSIVA DEL ENTORNO 3D ---
        function actualizarLayout3D() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
            
            // Si es celular, ubicamos la Tierra arriba a la derecha y más pequeña
            if (window.innerWidth < 768) {
                sistemaPlanetario.position.set(1.5, 4, -3);
                sistemaPlanetario.scale.set(0.6, 0.6, 0.6);
            } else {
                sistemaPlanetario.position.set(4, 3, -2);
                sistemaPlanetario.scale.set(1, 1, 1);
            }
        }
        window.addEventListener('resize', actualizarLayout3D);
        actualizarLayout3D(); // Ejecutar al inicio

        let tiempoAsteroide = 0;

        function animate3D() {
          requestAnimationFrame(animate3D);
          
          earth.rotation.y += 0.001;       
          clouds.rotation.y += 0.0015; // Las nubes giran más rápido
          moonPivot.rotation.y += 0.003;   
          moon.rotation.y += 0.002;        
          
          // Asteroide viajando por TODA la pantalla en órbitas amplias
          tiempoAsteroide += 0.005;
          asteroid.position.x = Math.cos(tiempoAsteroide * 0.8) * 8;
          asteroid.position.y = Math.sin(tiempoAsteroide * 1.5) * 6;
          asteroid.position.z = Math.sin(tiempoAsteroide * 1.2) * 5; 
          
          asteroid.rotation.x += 0.02;
          asteroid.rotation.y += 0.01;
          asteroid.rotation.z += 0.03;

          renderer.render(scene, camera);
        }
        animate3D();
      });

      // ==========================================
      // MOTOR 2D: DOS LIENZOS PARA SOLUCIONAR LAS CAPAS
      // ==========================================
      const canvasFondo = document.getElementById('universo-fondo');
      const ctxFondo = canvasFondo.getContext('2d');
      const canvasFrente = document.getElementById('universo-frente');
      const ctxFrente = canvasFrente.getContext('2d');
      
      const foto = document.getElementById('foto-annarella');
      
      let width, height;
      let estrellasFondo = []; 
      let estrellasDinamicas = []; 
      let puntosTexto = [];
      let progresoScroll = 0;

      function iniciar2D() {
        width = window.innerWidth;
        height = window.innerHeight;
        
        canvasFondo.width = width;
        canvasFondo.height = height;
        canvasFrente.width = width;
        canvasFrente.height = height;
        
        const esMovil = width < 768;
        const textoMostrar = esMovil ? "FELIZ\nCUMPLEAÑOS\nANNARELLA" : "FELIZ CUMPLEAÑOS\nANNARELLA";
        
        obtenerCoordenadasTexto(textoMostrar, esMovil);
        crearEstrellas(esMovil);
      }

      function obtenerCoordenadasTexto(texto, esMovil) {
        const canvasTemp = document.createElement('canvas');
        const ctxTemp = canvasTemp.getContext('2d');
        canvasTemp.width = width;
        canvasTemp.height = height;

        ctxTemp.fillStyle = 'white';
        let fontSize = esMovil ? '12vw' : '7vw'; 
        ctxTemp.font = `900 ${fontSize} "Arial Black", sans-serif`; 
        ctxTemp.textAlign = 'center';
        ctxTemp.textBaseline = 'middle';
        
        const lineas = texto.split('\n');
        // Bajamos el texto en móvil para que no choque con la foto
        const startY = esMovil ? height * 0.70 : height * 0.75; 
        const lineHeight = esMovil ? height * 0.08 : height * 0.12; 

        lineas.forEach((linea, index) => {
          ctxTemp.fillText(linea, width / 2, startY + (index * lineHeight));
        });

        const data = ctxTemp.getImageData(0, 0, width, height).data;
        puntosTexto = [];
        
        const saltoPixels = esMovil ? 8 : 6;
        for (let y = 0; y < height; y += saltoPixels) {
          for (let x = 0; x < width; x += saltoPixels) {
            const alpha = data[(y * width + x) * 4 + 3];
            if (alpha > 128) {
              puntosTexto.push({ x, y });
            }
          }
        }
      }

      function crearEstrellas(esMovil) {
        estrellasFondo = [];
        estrellasDinamicas = [];

        const cantidadFondo = esMovil ? 200 : 350;
        for (let i = 0; i < cantidadFondo; i++) {
          estrellasFondo.push({
            x: Math.random() * width,
            y: Math.random() * height,
            tamano: Math.random() * 1.5, 
            faseBrillo: Math.random() * Math.PI * 2,
            velocidadBrillo: Math.random() * 0.5 + 0.2 
          });
        }

        const numDinamicas = Math.max(puntosTexto.length, esMovil ? 250 : 500); 
        for (let i = 0; i < numDinamicas; i++) {
          const destino = puntosTexto[i] || {
            x: Math.random() * width,
            y: Math.random() * height
          };

          estrellasDinamicas.push({
            xInicial: Math.random() * width,
            yInicial: Math.random() * height,
            xDestino: destino.x,
            yDestino: destino.y,
            tamanoBase: Math.random() * 1.2 + 0.6, 
            formaTexto: i < puntosTexto.length,
            faseBrillo: Math.random() * Math.PI * 2, 
            velocidadBrillo: Math.random() * 2 + 1 
          });
        }
      }

      window.addEventListener('scroll', () => {
        const scrollMaximo = document.body.scrollHeight - window.innerHeight;
        progresoScroll = Math.min(Math.max(window.scrollY / scrollMaximo, 0), 1);
      });

      function animar2D() {
        ctxFondo.clearRect(0, 0, width, height);
        ctxFrente.clearRect(0, 0, width, height);
        
        const tiempo = Date.now() * 0.001; 
        let progresoAcelerado = Math.min(progresoScroll * 2, 1);
        let interpolacion = 1 - Math.pow(1 - progresoAcelerado, 3);

        if (progresoAcelerado > 0.4) {
           let progresoFoto = Math.min((progresoAcelerado - 0.4) * 1.66, 1);
           foto.style.opacity = progresoFoto;
           // En celular sube mucho más para quedar justo encima del texto
           let offsetAlto = width < 768 ? '-85%' : '-60%';
           foto.style.transform = `translate(-50%, ${offsetAlto}) scale(${0.7 + (progresoFoto * 0.3)})`;
        } else {
           foto.style.opacity = 0;
           foto.style.transform = `translate(-50%, -50%) scale(0.7)`;
        }

        // Se dibuja en ctxFondo (Detrás del planeta y la foto)
        estrellasFondo.forEach(estrella => {
          let oscilacion = Math.sin(tiempo * estrella.velocidadBrillo + estrella.faseBrillo);
          ctxFondo.fillStyle = `rgba(255, 255, 255, ${0.3 + (oscilacion * 0.4)})`;
          ctxFondo.beginPath();
          ctxFondo.arc(estrella.x, estrella.y, estrella.tamano, 0, Math.PI * 2);
          ctxFondo.fill();
        });

        // Se dibuja en ctxFrente (Por encima de TODO)
        estrellasDinamicas.forEach(estrella => {
          let xActual = estrella.xInicial + (estrella.xDestino - estrella.xInicial) * interpolacion;
          let yActual = estrella.yInicial + (estrella.yDestino - estrella.yInicial) * interpolacion;
          
          let oscilacion = Math.sin(tiempo * estrella.velocidadBrillo + estrella.faseBrillo);
          let tamanoActual = estrella.tamanoBase + (oscilacion * 0.3);

          if (estrella.formaTexto && progresoAcelerado > 0.6) {
            ctxFrente.fillStyle = `rgba(255, 105, 180, ${progresoAcelerado * 0.5})`; 
            ctxFrente.beginPath();
            ctxFrente.arc(xActual, yActual, tamanoActual * 3, 0, Math.PI * 2);
            ctxFrente.fill();
            ctxFrente.fillStyle = 'rgba(255, 255, 255, 1)'; 
          } else {
            ctxFrente.fillStyle = `rgba(255, 255, 255, ${0.5 + (oscilacion * 0.4)})`;
          }

          ctxFrente.beginPath();
          ctxFrente.arc(xActual, yActual, tamanoActual, 0, Math.PI * 2);
          ctxFrente.fill();
        });

        requestAnimationFrame(animar2D);
      }

      window.addEventListener('resize', iniciar2D);
      iniciar2D();
      animar2D();
    </script>
  </body>
</html>

<style>
  body, html {
    margin: 0;
    padding: 0;
    background-color: #020306; 
    color: white;
    font-family: sans-serif;
    overflow-x: hidden;
  }
  
  .nebulosa {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: 
      radial-gradient(circle at 20% 30%, rgba(55, 20, 80, 0.4) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(20, 60, 100, 0.3) 0%, transparent 50%),
      radial-gradient(circle at 50% 100%, rgba(100, 20, 60, 0.25) 0%, transparent 60%);
    z-index: 0;
  }

  /* ORDEN DE CAPAS PERFECTO (Z-INDEX) */
  #universo-fondo { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 1; pointer-events: none; }
  
  #contenedor-3d { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 2; pointer-events: none; }
  
  .estrella-fugaz, .meteorito { position: fixed; border-radius: 50%; z-index: 3; opacity: 0; pointer-events: none; }
  
  #foto-annarella { position: fixed; top: 40%; left: 50%; width: clamp(200px, 40vw, 350px); height: clamp(200px, 40vw, 350px); object-fit: cover; border-radius: 50%; z-index: 4; box-shadow: 0 0 40px rgba(255, 105, 180, 0.5), 0 0 100px rgba(0, 242, 254, 0.3); border: 3px solid rgba(255, 255, 255, 0.8); pointer-events: none; opacity: 0; }
  
  #universo-frente { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 5; pointer-events: none; }

  /* Estilos de las estrellas fugaces */
  .estrella-fugaz { width: 3px; height: 3px; background: white; box-shadow: 0 0 10px white; }
  .estrella-fugaz::after { content: ''; position: absolute; top: 50%; transform: translateY(-50%); width: 150px; height: 1px; background: linear-gradient(90deg, rgba(255,255,255,0.8), transparent); }

  .meteorito { width: 8px; height: 8px; background: #ffdb58; box-shadow: 0 0 20px #ffdb58, 0 0 40px #ff8c00; }
  .meteorito::after { content: ''; position: absolute; top: 50%; transform: translateY(-50%); width: 300px; height: 4px; background: linear-gradient(90deg, #ff8c00, #ff0000, transparent); }

  .fugaz-1 { top: 20%; left: 100%; animation: animarFugaz 7s linear infinite; animation-delay: 1s; }
  .fugaz-2 { top: 60%; left: 110%; animation: animarFugaz 11s linear infinite; animation-delay: 4s; }
  .fugaz-3 { top: 85%; left: 120%; animation: animarFugaz 14s linear infinite; animation-delay: 8s; }
  .meteoro-1 { top: 15%; left: 130%; animation: animarFugaz 15s linear infinite; animation-delay: 5s; }
  .meteoro-2 { top: 70%; left: 150%; animation: animarFugaz 22s linear infinite; animation-delay: 12s; }

  @keyframes animarFugaz {
    0% { transform: translateX(0) translateY(0) rotate(-35deg); opacity: 1; }
    3% { opacity: 1; }
    10% { opacity: 0; }
    100% { transform: translateX(-2500px) translateY(1750px) rotate(-35deg); opacity: 0; }
  }

  .contenedor-scroll { position: relative; height: 300vh; z-index: 10; }
  
  .indicador { position: fixed; top: 5%; width: 100%; text-align: center; pointer-events: none; opacity: 0.7; text-shadow: 0px 0px 10px rgba(255,255,255,0.5); }

  /* Media Queries Móviles Extras */
  @media (max-width: 768px) {
    .indicador h1 { font-size: 5vw; }
    #foto-annarella {
      width: clamp(140px, 45vw, 220px);
      height: clamp(140px, 45vw, 220px);
      top: 35%;
    }
  }
</style>