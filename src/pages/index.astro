---
// src/pages/index.astro
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Espacio Profundo Wister</title>
  </head>
  <body>
    <!-- Capa de colores de gas espacial (Nebulosa) -->
    <div class="nebulosa"></div>
    
    <!-- Animaciones de estrellas fugaces -->
    <div class="estrella-fugaz fugaz-1"></div>
    <div class="estrella-fugaz fugaz-2"></div>

    <!-- Lienzo donde se dibujan las estrellas -->
    <canvas id="universo"></canvas>

    <main class="contenedor-scroll">
      <div class="indicador">
        <h1>Baja para ver la magia 👇</h1>
      </div>
    </main>

    <script>
      const canvas = document.getElementById('universo');
      const ctx = canvas.getContext('2d');
      let width, height;
      
      let estrellasFondo = []; 
      let estrellasDinamicas = []; 
      let puntosTexto = [];
      let progresoScroll = 0;

      const FRASE = "WISTER"; 

      function iniciar() {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
        obtenerCoordenadasTexto(FRASE);
        crearEstrellas();
      }

      function obtenerCoordenadasTexto(texto) {
        const canvasTemp = document.createElement('canvas');
        const ctxTemp = canvasTemp.getContext('2d');
        canvasTemp.width = width;
        canvasTemp.height = height;

        ctxTemp.fillStyle = 'white';
        ctxTemp.font = '900 18vw sans-serif'; 
        ctxTemp.textAlign = 'center';
        ctxTemp.textBaseline = 'middle';
        ctxTemp.fillText(texto, width / 2, height / 2);

        const data = ctxTemp.getImageData(0, 0, width, height).data;
        puntosTexto = [];
        
        for (let y = 0; y < height; y += 4) {
          for (let x = 0; x < width; x += 4) {
            const alpha = data[(y * width + x) * 4 + 3];
            if (alpha > 128) {
              puntosTexto.push({ x, y });
            }
          }
        }
      }

      function crearEstrellas() {
        estrellasFondo = [];
        estrellasDinamicas = [];

        // 1. Reducimos el polvo estelar a solo 400 estrellas para un cielo limpio
        for (let i = 0; i < 400; i++) {
          estrellasFondo.push({
            x: Math.random() * width,
            y: Math.random() * height,
            tamano: Math.random() * 1.2, 
            faseBrillo: Math.random() * Math.PI * 2,
            velocidadBrillo: Math.random() * 0.5 + 0.2 
          });
        }

        // 2. Estrellas dinámicas (ahora también serán puntos redondos)
        const numDinamicas = Math.max(puntosTexto.length, 600); 
        for (let i = 0; i < numDinamicas; i++) {
          const destino = puntosTexto[i] || {
            x: Math.random() * width,
            y: Math.random() * height
          };

          estrellasDinamicas.push({
            xInicial: Math.random() * width,
            yInicial: Math.random() * height,
            xDestino: destino.x,
            yDestino: destino.y,
            // Tamaño ajustado para que parezcan estrellas de la capa 1
            tamanoBase: Math.random() * 1.5 + 0.8, 
            formaTexto: i < puntosTexto.length,
            faseBrillo: Math.random() * Math.PI * 2, 
            velocidadBrillo: Math.random() * 2 + 1 
          });
        }
      }

      window.addEventListener('scroll', () => {
        const scrollMaximo = document.body.scrollHeight - window.innerHeight;
        progresoScroll = Math.min(Math.max(window.scrollY / scrollMaximo, 0), 1);
      });

      function animar() {
        ctx.clearRect(0, 0, width, height);
        const tiempo = Date.now() * 0.001; 
        let progresoAcelerado = Math.min(progresoScroll * 2, 1);
        let interpolacion = 1 - Math.pow(1 - progresoAcelerado, 3);

        // --- DIBUJAR EL POLVO ESTELAR DEL FONDO (Capa 1) ---
        estrellasFondo.forEach(estrella => {
          let oscilacion = Math.sin(tiempo * estrella.velocidadBrillo + estrella.faseBrillo);
          let opacidad = 0.3 + (oscilacion * 0.4); 
          
          ctx.fillStyle = `rgba(255, 255, 255, ${opacidad})`;
          ctx.shadowBlur = 0; 
          
          ctx.beginPath();
          ctx.arc(estrella.x, estrella.y, estrella.tamano, 0, Math.PI * 2);
          ctx.fill();
        });

        // --- DIBUJAR LAS ESTRELLAS DINÁMICAS (Capa 2 - Ahora con el mismo diseño) ---
        estrellasDinamicas.forEach(estrella => {
          let xActual = estrella.xInicial + (estrella.xDestino - estrella.xInicial) * interpolacion;
          let yActual = estrella.yInicial + (estrella.yDestino - estrella.yInicial) * interpolacion;
          
          let oscilacion = Math.sin(tiempo * estrella.velocidadBrillo + estrella.faseBrillo);
          let tamanoActual = estrella.tamanoBase + (oscilacion * 0.3);

          if (estrella.formaTexto && progresoAcelerado > 0.6) {
            ctx.fillStyle = 'rgba(255, 255, 255, 1)';
            ctx.shadowBlur = 15 * progresoAcelerado; 
            ctx.shadowColor = '#00f2fe'; 
          } else {
            let opacidad = 0.5 + (oscilacion * 0.4);
            ctx.fillStyle = `rgba(255, 255, 255, ${opacidad})`;
            ctx.shadowBlur = oscilacion > 0 ? oscilacion * 4 : 0; 
            ctx.shadowColor = '#a8c0ff'; 
          }

          // Usamos puntos redondos en lugar de la cruz de 4 puntas
          ctx.beginPath();
          ctx.arc(xActual, yActual, tamanoActual, 0, Math.PI * 2);
          ctx.fill();
        });

        requestAnimationFrame(animar);
      }

      window.addEventListener('resize', iniciar);
      iniciar();
      animar();
    </script>
  </body>
</html>

<style>
  body, html {
    margin: 0;
    padding: 0;
    background-color: #030509; 
    color: white;
    font-family: sans-serif;
  }
  
  .nebulosa {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: 
      radial-gradient(circle at 15% 40%, rgba(31, 23, 76, 0.4) 0%, transparent 40%),
      radial-gradient(circle at 80% 70%, rgba(16, 52, 92, 0.4) 0%, transparent 50%),
      radial-gradient(circle at 50% 10%, rgba(8, 23, 48, 0.5) 0%, transparent 60%);
    z-index: 0;
  }

  #universo {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 1;
    pointer-events: none;
  }
  
  .estrella-fugaz {
    position: fixed;
    width: 3px;
    height: 3px;
    background: white;
    border-radius: 50%;
    box-shadow: 0 0 15px white, 0 0 30px white;
    z-index: 0;
    opacity: 0;
  }
  .estrella-fugaz::after {
    content: '';
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 120px; 
    height: 1px;
    background: linear-gradient(90deg, rgba(255,255,255,0.8), transparent);
  }

  .fugaz-1 {
    top: 20%;
    left: 80%;
    animation: animarFugaz 8s linear infinite;
    animation-delay: 2s; 
  }

  .fugaz-2 {
    top: 60%;
    left: 90%;
    animation: animarFugaz 15s linear infinite;
    animation-delay: 7s;
  }

  @keyframes animarFugaz {
    0% { transform: translateX(0) translateY(0) rotate(-40deg); opacity: 1; }
    5% { opacity: 0; }
    100% { transform: translateX(-1500px) translateY(1200px) rotate(-40deg); opacity: 0; }
  }

  .contenedor-scroll {
    position: relative;
    height: 300vh;
    z-index: 10;
  }
  
  .indicador {
    position: fixed;
    top: 15%;
    width: 100%;
    text-align: center;
    pointer-events: none;
    opacity: 0.7;
    text-shadow: 0px 0px 10px rgba(255,255,255,0.5);
  }
</style>